"use client";

import dynamic from "next/dynamic";
import { useEffect, useMemo, useState } from "react";
import {
  ChevronRight,
  Globe2,
  Loader2,
  MapPinned,
  Search,
  Sprout,
  Trophy,
  Wheat,
} from "lucide-react";
import {
  CartesianGrid,
  Line,
  LineChart,
  ResponsiveContainer,
  Tooltip as ChartTooltip,
  XAxis,
  YAxis,
} from "recharts";
import type { AgricultureMapRow } from "./_components/AgricultureMap";

const AgricultureMap = dynamic(
  () => import("./_components/AgricultureMap"),
  {
    ssr: false,
    loading: () => (
      <div className="flex min-h-[410px] items-center justify-center rounded-[24px] bg-slate-100">
        <div className="flex items-center gap-2 text-sm font-bold text-slate-500">
          <Loader2 className="h-5 w-5 animate-spin" />
          Preparing map
        </div>
      </div>
    ),
  },
);

type CropMeta = {
  key: string;
  label: string;
  itemCode: string;
  cpc?: string;
  group: string;
  countries?: number;
  fileKB?: number;
};

type MetaPayload = {
  source: string;
  sourceMode: string;
  catalogueMode?: string;
  metric: string;
  minYear: number;
  latestYear: number;
  generatedAt: string;
  cropCount?: number;
  crops: CropMeta[];
};

type StaticCountry = {
  iso3: string;
  m49: string;
  country: string;
  lat: number;
  lng: number;
  unit: string;
  series: unknown[];
};

type CropPayload = {
  source: string;
  sourceMode: string;
  cropKey: string;
  crop: string;
  itemCode: string;
  cpc?: string;
  group: string;
  metric: string;
  minYear: number;
  latestYear: number;
  generatedAt: string;
  countries: StaticCountry[];
};

type TrendPoint = {
  year: number;
  value: number;
  unit: string;
};

function normalizeSeries(raw: unknown): Array<[number, number]> {
  if (!Array.isArray(raw) || raw.length === 0) {
    return [];
  }

  const first = raw[0];

  if (Array.isArray(first)) {
    const nested: Array<[number, number]> = [];

    for (const entry of raw) {
      if (!Array.isArray(entry) || entry.length < 2) {
        continue;
      }

      const seriesYear = Number(entry[0]);
      const seriesValue = Number(entry[1]);

      if (
        Number.isFinite(seriesYear) &&
        Number.isFinite(seriesValue)
      ) {
        nested.push([seriesYear, seriesValue]);
      }
    }

    return nested;
  }

  // Compatibility with any older flattened cache:
  // [1992, value, 1993, value, ...]
  const flat: Array<[number, number]> = [];

  for (let index = 0; index + 1 < raw.length; index += 2) {
    const seriesYear = Number(raw[index]);
    const seriesValue = Number(raw[index + 1]);

    if (
      Number.isFinite(seriesYear) &&
      Number.isFinite(seriesValue)
    ) {
      flat.push([seriesYear, seriesValue]);
    }
  }

  return flat;
}

function formatNumber(
  value: number,
  maximumFractionDigits = 1,
) {
  if (!Number.isFinite(value)) {
    return "n/a";
  }

  return new Intl.NumberFormat("en", {
    maximumFractionDigits,
  }).format(value);
}

function compact(value: number) {
  if (!Number.isFinite(value)) {
    return "n/a";
  }

  return new Intl.NumberFormat("en", {
    notation: "compact",
    maximumFractionDigits: 2,
  }).format(value);
}

function Selector({
  label,
  value,
  onChange,
  children,
}: {
  label: string;
  value: string | number;
  onChange: (value: string) => void;
  children: React.ReactNode;
}) {
  return (
    <label className="min-w-[170px] flex-1">
      <span className="mb-1 block text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
        {label}
      </span>

      <select
        value={value}
        onChange={(event) => onChange(event.target.value)}
        className="h-10 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-bold text-slate-800 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100"
      >
        {children}
      </select>
    </label>
  );
}

export default function AgriculturePage() {
  const [meta, setMeta] = useState<MetaPayload | null>(null);
  const [crop, setCrop] = useState("wheat");
  const [year, setYear] = useState(2024);
  const [cropData, setCropData] = useState<CropPayload | null>(
    null,
  );
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [selectedIso3, setSelectedIso3] = useState<
    string | null
  >(null);
  const [countryQuery, setCountryQuery] = useState("");

  useEffect(() => {
    let active = true;

    fetch(
      `/data/agriculture/meta.json?v=catalogue-clean`,
      {
        cache: "no-store",
      },
    )
      .then(async (response) => {
        if (!response.ok) {
          throw new Error(
            `Agriculture metadata HTTP ${response.status}`,
          );
        }

        return (await response.json()) as MetaPayload;
      })
      .then((payload) => {
        if (!active) {
          return;
        }

        setMeta(payload);

        if (payload.latestYear) {
          setYear(payload.latestYear);
        }

        // Keep wheat when available; otherwise use first catalogue item.
        if (
          !payload.crops.some((item) => item.key === crop) &&
          payload.crops.length > 0
        ) {
          setCrop(payload.crops[0].key);
        }
      })
      .catch((err: unknown) => {
        if (!active) {
          return;
        }

        setError(
          err instanceof Error
            ? err.message
            : "Unable to load Agriculture Atlas metadata.",
        );
      });

    return () => {
      active = false;
    };
  }, []);

  useEffect(() => {
    if (!meta) {
      return;
    }

    let active = true;

    const dataVersion =
      meta.generatedAt || "catalogue-clean";

    const cacheKey =
      `stratify:agriculture:static:${dataVersion}:${crop}`;

    setLoading(true);
    setError("");

    try {
      const cached = sessionStorage.getItem(cacheKey);

      if (cached) {
        const parsed = JSON.parse(cached) as CropPayload;

        if (
          parsed?.cropKey === crop &&
          Array.isArray(parsed.countries)
        ) {
          setCropData(parsed);
          setLoading(false);

          if (year > parsed.latestYear) {
            setYear(parsed.latestYear);
          }

          return () => {
            active = false;
          };
        }
      }
    } catch {
      // Local static fetch remains the fallback.
    }

    fetch(
      `/data/agriculture/${crop}.json?v=${encodeURIComponent(
        dataVersion,
      )}`,
      {
        cache: "no-cache",
      },
    )
      .then(async (response) => {
        if (!response.ok) {
          throw new Error(
            `Local crop dataset HTTP ${response.status}: ${crop}`,
          );
        }

        return (await response.json()) as CropPayload;
      })
      .then((payload) => {
        if (!active) {
          return;
        }

        setCropData(payload);

        if (year > payload.latestYear) {
          setYear(payload.latestYear);
        }

        try {
          sessionStorage.setItem(
            cacheKey,
            JSON.stringify(payload),
          );
        } catch {
          // Browser storage is optional.
        }
      })
      .catch((err: unknown) => {
        if (!active) {
          return;
        }

        setCropData(null);

        setError(
          err instanceof Error
            ? err.message
            : "Unable to load local crop data.",
        );
      })
      .finally(() => {
        if (active) {
          setLoading(false);
        }
      });

    return () => {
      active = false;
    };
  }, [crop, meta?.generatedAt]);

  const rows = useMemo<AgricultureMapRow[]>(() => {
    if (!cropData) {
      return [];
    }

    const base = cropData.countries
      .map((country) => {
        const normalizedSeries =
          normalizeSeries(country.series);

        const observation = normalizedSeries.find(
          ([seriesYear]) => seriesYear === year,
        );

        if (!observation) {
          return null;
        }

        const value = Number(observation[1]);

        if (!Number.isFinite(value)) {
          return null;
        }

        return {
          iso3: country.iso3,
          areaCode: country.m49,
          country: country.country,
          lat: country.lat,
          lng: country.lng,
          crop: cropData.crop,
          cropKey: cropData.cropKey,
          year,
          value,
          unit: country.unit || "t",
          rank: null,
          sharePct: null,
        } satisfies AgricultureMapRow;
      })
      .filter(
        (row): row is AgricultureMapRow => row !== null,
      );

    base.sort((a, b) => b.value - a.value);

    const globalTotal = base.reduce(
      (sum, row) => sum + row.value,
      0,
    );

    return base.map((row, index) => ({
      ...row,
      rank: index + 1,
      sharePct:
        globalTotal > 0
          ? (row.value / globalTotal) * 100
          : null,
    }));
  }, [cropData, year]);

  const globalTotal = useMemo(
    () =>
      rows.reduce(
        (sum, row) => sum + row.value,
        0,
      ),
    [rows],
  );

  const selected = useMemo(
    () =>
      rows.find(
        (row) => row.iso3 === selectedIso3,
      ) ?? null,
    [rows, selectedIso3],
  );

  // Never auto-select the top producer.
  // Initial map therefore remains a global distribution view.
  useEffect(() => {
    setSelectedIso3((current) => {
      if (
        current &&
        rows.some((row) => row.iso3 === current)
      ) {
        return current;
      }

      return null;
    });
  }, [rows]);

  const trend = useMemo<TrendPoint[]>(() => {
    if (!cropData || !selectedIso3) {
      return [];
    }

    const country = cropData.countries.find(
      (item) => item.iso3 === selectedIso3,
    );

    if (!country) {
      return [];
    }

    return normalizeSeries(country.series)
      .map(([seriesYear, value]) => ({
        year: seriesYear,
        value,
        unit: country.unit || "t",
      }))
      .sort((a, b) => a.year - b.year)
      .slice(-30);
  }, [cropData, selectedIso3]);

  const topRows = rows.slice(0, 10);

  const searchMatches = useMemo(() => {
    const query = countryQuery
      .trim()
      .toLowerCase();

    if (query.length < 2) {
      return [];
    }

    return rows
      .filter(
        (row) =>
          row.country
            .toLowerCase()
            .includes(query) ||
          row.iso3
            .toLowerCase()
            .includes(query),
      )
      .slice(0, 7);
  }, [countryQuery, rows]);

  const years = useMemo(() => {
    const max =
      cropData?.latestYear ??
      meta?.latestYear ??
      2024;

    const min =
      cropData?.minYear ??
      meta?.minYear ??
      1961;

    const values: number[] = [];

    for (
      let current = max;
      current >= min;
      current -= 1
    ) {
      values.push(current);
    }

    return values;
  }, [cropData, meta]);

  const cropGroups = useMemo(() => {
    const groups = new Map<
      string,
      CropMeta[]
    >();

    for (const item of meta?.crops ?? []) {
      const list =
        groups.get(item.group) ?? [];

      list.push(item);
      groups.set(item.group, list);
    }

    return [...groups.entries()];
  }, [meta]);

  function selectRow(row: AgricultureMapRow) {
    setSelectedIso3(row.iso3);
    setCountryQuery("");
  }

  return (
    <main className="min-h-screen bg-slate-100">
      <div className="mx-auto w-full max-w-[1480px] px-4 py-5 sm:px-6 lg:px-8">
        <section className="rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div className="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
            <div className="max-w-3xl">
              <div className="flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.16em] text-emerald-700">
                <Sprout className="h-4 w-4" />
                Agriculture Atlas
              </div>

              <h1 className="mt-1 text-[30px] font-black tracking-[-0.035em] text-slate-950 sm:text-[34px]">
                Global Crop Production
              </h1>

              <p className="mt-1 max-w-2xl text-sm font-medium leading-6 text-slate-600">
                Explore national agricultural output on an
                interactive proportional-point map. Crop data is
                served from a compact local FAOSTAT snapshot for
                fast loading.
              </p>
            </div>

            <div className="flex flex-wrap gap-2">
              <div className="rounded-2xl bg-emerald-50 px-3 py-2 text-xs font-black text-emerald-800">
                FAOSTAT QCL
              </div>

              <div className="rounded-2xl bg-indigo-50 px-3 py-2 text-xs font-black text-indigo-700">
                Local cached snapshot
              </div>
            </div>
          </div>

          <div className="mt-5 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3 lg:flex-row lg:items-end">
            <Selector
              label={`Crop (${meta?.crops?.length ?? 0} available)`}
              value={crop}
              onChange={setCrop}
            >
              {cropGroups.map(
                ([group, groupCrops]) => (
                  <optgroup
                    key={group}
                    label={group}
                  >
                    {groupCrops.map((item) => (
                      <option
                        key={item.key}
                        value={item.key}
                      >
                        {item.label}
                      </option>
                    ))}
                  </optgroup>
                ),
              )}
            </Selector>

            <Selector
              label="Year"
              value={year}
              onChange={(value) =>
                setYear(Number(value))
              }
            >
              {years.map((item) => (
                <option
                  key={item}
                  value={item}
                >
                  {item}
                </option>
              ))}
            </Selector>

            <div className="relative min-w-[240px] flex-[1.25]">
              <label className="mb-1 block text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
                Find country
              </label>

              <div className="relative">
                <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />

                <input
                  value={countryQuery}
                  onChange={(event) =>
                    setCountryQuery(
                      event.target.value,
                    )
                  }
                  placeholder="Type at least 2 characters"
                  className="h-10 w-full rounded-xl border border-slate-200 bg-white pl-9 pr-3 text-sm font-semibold text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100"
                />
              </div>

              {searchMatches.length > 0 ? (
                <div className="absolute z-[700] mt-1 w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
                  {searchMatches.map((row) => (
                    <button
                      key={row.iso3}
                      type="button"
                      onClick={() =>
                        selectRow(row)
                      }
                      className="flex w-full items-center justify-between gap-3 border-b border-slate-100 px-3 py-2 text-left last:border-b-0 hover:bg-slate-50"
                    >
                      <span>
                        <span className="block text-sm font-black text-slate-800">
                          {row.country}
                        </span>

                        <span className="block text-[10px] font-bold text-slate-400">
                          {row.iso3}
                        </span>
                      </span>

                      <span className="text-xs font-black text-emerald-700">
                        {compact(row.value)}{" "}
                        {row.unit}
                      </span>
                    </button>
                  ))}
                </div>
              ) : null}
            </div>

            <div className="min-w-[190px] rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5">
              <div className="text-[10px] font-black uppercase tracking-[0.12em] text-emerald-600">
                Metric
              </div>

              <div className="text-sm font-black text-emerald-950">
                Production quantity
              </div>
            </div>
          </div>
        </section>

        {error ? (
          <section className="mt-4 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold leading-6 text-rose-800">
            <div className="font-black">
              Agriculture Atlas local dataset could not
              load.
            </div>

            <div className="mt-1">
              {error}
            </div>
          </section>
        ) : null}

        <section className="relative mt-4">
          <div className="grid gap-4 xl:grid-cols-[minmax(0,1fr)_330px]">
            <div className="relative overflow-hidden rounded-[28px] border border-slate-200 bg-white p-2 shadow-sm">
              {loading ? (
                <div className="pointer-events-none absolute left-5 top-5 z-[750] flex items-center gap-2 rounded-xl border border-slate-200 bg-white/95 px-3 py-2 text-xs font-black text-slate-700 shadow-md backdrop-blur">
                  <Loader2 className="h-4 w-4 animate-spin text-indigo-600" />
                  Loading crop data
                </div>
              ) : null}

              <AgricultureMap
                rows={rows}
                selectedIso3={selectedIso3}
                onSelect={selectRow}
              />
            </div>

            <aside className="flex min-h-[426px] flex-col overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-sm">
              <div className="border-b border-slate-100 p-4">
                <div className="flex items-center gap-2">
                  <Trophy className="h-4 w-4 text-amber-600" />

                  <h2 className="text-base font-black text-slate-900">
                    Top Producers
                  </h2>
                </div>

                <p className="mt-1 text-xs font-semibold text-slate-500">
                  {cropData?.crop ??
                    "Selected crop"}{" "}
                  | {year}
                </p>
              </div>

              <div className="min-h-0 flex-1 overflow-auto">
                {topRows.map((row) => {
                  const active =
                    row.iso3 === selectedIso3;

                  return (
                    <button
                      key={row.iso3}
                      type="button"
                      onClick={() =>
                        selectRow(row)
                      }
                      className={[
                        "flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left transition",
                        active
                          ? "bg-indigo-50"
                          : "hover:bg-slate-50",
                      ].join(" ")}
                    >
                      <div
                        className={[
                          "flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-black",
                          active
                            ? "bg-indigo-600 text-white"
                            : "bg-slate-100 text-slate-600",
                        ].join(" ")}
                      >
                        {row.rank}
                      </div>

                      <div className="min-w-0 flex-1">
                        <div className="truncate text-sm font-black text-slate-800">
                          {row.country}
                        </div>

                        <div className="text-[10px] font-bold text-slate-400">
                          {row.sharePct == null
                            ? row.iso3
                            : `${row.sharePct.toFixed(
                                2,
                              )}% global share`}
                        </div>
                      </div>

                      <div className="shrink-0 text-right">
                        <div className="text-xs font-black text-emerald-700">
                          {compact(row.value)}
                        </div>

                        <div className="text-[9px] font-bold text-slate-400">
                          {row.unit}
                        </div>
                      </div>

                      <ChevronRight className="h-4 w-4 text-slate-300" />
                    </button>
                  );
                })}

                {!loading &&
                topRows.length === 0 ? (
                  <div className="p-5 text-sm font-semibold text-slate-500">
                    No production observations are
                    available for this crop/year.
                  </div>
                ) : null}
              </div>
            </aside>
          </div>
        </section>

        <section className="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <div className="rounded-[22px] border border-slate-200 bg-white p-4 shadow-sm">
            <div className="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
              <Globe2 className="h-4 w-4 text-indigo-500" />
              Global production
            </div>

            <div className="mt-2 text-2xl font-black text-slate-950">
              {compact(globalTotal)}

              <span className="ml-1 text-sm text-slate-500">
                {rows[0]?.unit ?? ""}
              </span>
            </div>

            <div className="mt-1 text-xs font-semibold text-slate-500">
              Sum of country observations for {year}
            </div>
          </div>

          <div className="rounded-[22px] border border-slate-200 bg-white p-4 shadow-sm">
            <div className="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
              <Trophy className="h-4 w-4 text-amber-500" />
              Top producer
            </div>

            <div className="mt-2 truncate text-2xl font-black text-slate-950">
              {rows[0]?.country ?? "n/a"}
            </div>

            <div className="mt-1 text-xs font-semibold text-slate-500">
              {rows[0]
                ? `${compact(
                    rows[0].value,
                  )} ${rows[0].unit}`
                : "No data"}
            </div>
          </div>

          <div className="rounded-[22px] border border-slate-200 bg-white p-4 shadow-sm">
            <div className="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
              <MapPinned className="h-4 w-4 text-emerald-600" />
              Selected country
            </div>

            <div className="mt-2 truncate text-2xl font-black text-slate-950">
              {selected?.country ??
                "Select a point"}
            </div>

            <div className="mt-1 text-xs font-semibold text-slate-500">
              {selected
                ? `${compact(
                    selected.value,
                  )} ${selected.unit}`
                : "Click any country marker"}
            </div>
          </div>

          <div className="rounded-[22px] border border-slate-200 bg-white p-4 shadow-sm">
            <div className="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
              <Wheat className="h-4 w-4 text-emerald-600" />
              Global rank
            </div>

            <div className="mt-2 text-2xl font-black text-slate-950">
              {selected?.rank
                ? `#${selected.rank}`
                : "n/a"}
            </div>

            <div className="mt-1 text-xs font-semibold text-slate-500">
              {selected?.sharePct == null
                ? `${rows.length} countries with data`
                : `${selected.sharePct.toFixed(
                    2,
                  )}% of global total`}
            </div>
          </div>
        </section>

        <section className="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1.35fr)_minmax(360px,0.65fr)]">
          <div className="rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm">
            <div>
              <div className="text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
                Historical production
              </div>

              <h2 className="mt-1 text-lg font-black text-slate-900">
                {selected?.country ?? "Country"} |{" "}
                {cropData?.crop ?? "Crop"}
              </h2>
            </div>

            <div className="mt-4 h-[280px]">
              {trend.length > 0 ? (
                <ResponsiveContainer
                  width="100%"
                  height="100%"
                >
                  <LineChart
                    data={trend}
                    margin={{
                      top: 10,
                      right: 16,
                      left: 4,
                      bottom: 0,
                    }}
                  >
                    <CartesianGrid
                      strokeDasharray="3 3"
                      stroke="#e2e8f0"
                    />

                    <XAxis
                      dataKey="year"
                      tick={{
                        fontSize: 10,
                        fill: "#64748b",
                        fontWeight: 700,
                      }}
                      tickLine={false}
                      axisLine={{
                        stroke: "#cbd5e1",
                      }}
                      minTickGap={24}
                    />

                    <YAxis
                      tickFormatter={(value) =>
                        compact(
                          Number(value),
                        )
                      }
                      tick={{
                        fontSize: 10,
                        fill: "#64748b",
                        fontWeight: 700,
                      }}
                      tickLine={false}
                      axisLine={false}
                      width={58}
                    />

                    <ChartTooltip
                      formatter={(
                        value:
                          | number
                          | string,
                      ) => [
                        `${formatNumber(
                          Number(value),
                          0,
                        )} ${
                          trend[0]?.unit ??
                          ""
                        }`,
                        "Production",
                      ]}
                      labelFormatter={(label) =>
                        `Year ${label}`
                      }
                      contentStyle={{
                        borderRadius: 12,
                        border:
                          "1px solid #e2e8f0",
                        boxShadow:
                          "0 10px 28px rgba(15,23,42,0.10)",
                      }}
                    />

                    <Line
                      type="monotone"
                      dataKey="value"
                      stroke="#4f46e5"
                      strokeWidth={2.5}
                      dot={false}
                      activeDot={{ r: 5 }}
                      isAnimationActive={false}
                    />
                  </LineChart>
                </ResponsiveContainer>
              ) : (
                <div className="flex h-full items-center justify-center rounded-2xl bg-slate-50 text-sm font-semibold text-slate-500">
                  Select a country point to view
                  historical records.
                </div>
              )}
            </div>
          </div>

          <div className="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-sm">
            <div className="border-b border-slate-100 p-5">
              <div className="text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
                Annual records
              </div>

              <h2 className="mt-1 text-lg font-black text-slate-900">
                Production table
              </h2>
            </div>

            <div className="max-h-[330px] overflow-auto">
              <table className="w-full border-collapse text-left">
                <thead className="sticky top-0 z-10 bg-slate-50">
                  <tr className="text-[10px] font-black uppercase tracking-[0.1em] text-slate-400">
                    <th className="px-4 py-2.5">
                      Year
                    </th>

                    <th className="px-4 py-2.5 text-right">
                      Production
                    </th>

                    <th className="px-4 py-2.5">
                      Unit
                    </th>
                  </tr>
                </thead>

                <tbody className="divide-y divide-slate-100">
                  {[...trend]
                    .sort(
                      (a, b) =>
                        b.year - a.year,
                    )
                    .map((point) => (
                      <tr
                        key={point.year}
                        className="hover:bg-slate-50"
                      >
                        <td className="px-4 py-2.5 text-sm font-black text-slate-700">
                          {point.year}
                        </td>

                        <td className="px-4 py-2.5 text-right text-sm font-black tabular-nums text-slate-900">
                          {formatNumber(
                            point.value,
                            0,
                          )}
                        </td>

                        <td className="px-4 py-2.5 text-xs font-bold text-slate-500">
                          {point.unit}
                        </td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section className="mt-4 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-[11px] font-semibold leading-5 text-slate-500 shadow-sm">
          Source: FAOSTAT Crops and livestock products
          (QCL). Production data is pre-filtered into
          compact local crop files. Map points are
          representative country locations; values are
          national totals, not city or farm coordinates.
        </section>
      </div>
    </main>
  );
}