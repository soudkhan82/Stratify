type WdiPoint = {
  year: number;
  value: number;
  unit?: string | null;
};

type WdiResponse = {
  iso3: string;
  country: string;
  region: string | null;
  indicator: {
    code: string;
    label: string;
    unit: string | null;
  };
  latest: WdiPoint | null;
  series: WdiPoint[];
  error?: string;
};

type TabKey =
  | "profile"
  | "wdi";

type Props = {
  open: boolean;
  iso3: string | null;
  countryName?: string | null;
  region?: string | null;
  initialIndicator: string;
